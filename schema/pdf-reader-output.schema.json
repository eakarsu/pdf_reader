{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-pdf-reader:output:1.0.0",
  "title": "Local PDF Reader output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "source",
    "page_count",
    "metadata",
    "summary",
    "pages"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "document_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "media_type", "byte_size", "sha256"],
      "properties": {
        "file_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "media_type": {
          "const": "application/pdf"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 26214400
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "page_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "maxLength": 2000 },
        "author": { "type": "string", "maxLength": 2000 },
        "subject": { "type": "string", "maxLength": 2000 },
        "creator": { "type": "string", "maxLength": 2000 },
        "producer": { "type": "string", "maxLength": 2000 },
        "creation_date": { "type": "string", "maxLength": 2000 },
        "modification_date": { "type": "string", "maxLength": 2000 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extracted_pages", "needs_ocr_pages", "failed_pages"],
      "properties": {
        "extracted_pages": { "type": "integer", "minimum": 0 },
        "needs_ocr_pages": { "type": "integer", "minimum": 0 },
        "failed_pages": { "type": "integer", "minimum": 0 }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page_number",
          "source_document_id",
          "extraction_status",
          "character_count",
          "dimensions",
          "text",
          "error_code"
        ],
        "properties": {
          "page_number": { "type": "integer", "minimum": 1, "maximum": 100 },
          "source_document_id": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "extraction_status": {
            "enum": ["extracted", "needs_ocr", "failed"]
          },
          "character_count": { "type": "integer", "minimum": 0 },
          "dimensions": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["width_points", "height_points", "rotation_degrees"],
                "properties": {
                  "width_points": { "type": "number", "exclusiveMinimum": 0 },
                  "height_points": { "type": "number", "exclusiveMinimum": 0 },
                  "rotation_degrees": { "type": "number" }
                }
              }
            ]
          },
          "text": { "type": "string" },
          "error_code": {
            "type": ["string", "null"],
            "enum": ["page_extraction_failed", null]
          }
        }
      }
    }
  }
}
