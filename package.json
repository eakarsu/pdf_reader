{
  "name": "local-pdf-reader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run && node --test scripts/runtime-api.test.mjs",
    "test:coverage": "vitest run --coverage",
    "schema:check": "node scripts/check-schema.mjs",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "security:audit": "npm audit --audit-level=high",
    "check": "npm run security:secrets && npm run schema:check && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "pdfjs-dist": "6.1.200",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "29.1.1",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
